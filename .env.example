# All variables are OPTIONAL — VersusAI runs with none of them set.
#
# ── LLM ────────────────────────────────────────────────────────────────────
# When ANTHROPIC_API_KEY is absent, the verdict engine falls back to a
# deterministic local mock so the app runs and tests pass for free.
ANTHROPIC_API_KEY=
# Override the verdict model (defaults to claude-sonnet-4-6).
VERSUSAI_MODEL=

# ── Persistence ────────────────────────────────────────────────────────────
# When no Firebase credentials are configured, battle records / cache /
# aggregates use an in-memory store (does not survive a cold start).
# Provide EITHER a path to a service-account JSON via GOOGLE_APPLICATION_CREDENTIALS,
# OR the JSON inline via FIREBASE_SERVICE_ACCOUNT.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=

# Public base URL used when composing share permalinks (defaults to relative).
NEXT_PUBLIC_BASE_URL=
